# io-docusia — Landing page gestion documental
# Valores reales en E:\master.env (IO_DOCUSIA_*)

NODE_ENV=development
PORT=3006

IO_DOCUSIA_FRONTEND_PORT=3006
IO_DOCUSIA_BACKEND_PORT=4001
IO_DOCUSIA_FRONTEND_URL=http://localhost:3006

IO_DOCUSIA_SUPABASE_URL=https://zvehtloitnuglyjtxwye.supabase.co
IO_DOCUSIA_SUPABASE_KEY=your_supabase_anon_key_here

# Muro de autenticación (solo se aplica cuando NODE_ENV=production).
# Obligatorias en producción — sin estas 3 variables el muro deniega el acceso a todos
# (fail-closed: no hay contraseña por defecto en el código). Configúralas en el panel
# de producción (Coolify), NO las pongas en un archivo versionado.
DOCUSIA_AUTH_USER=changeme
DOCUSIA_AUTH_PASS=changeme
DOCUSIA_AUTH_SECRET=changeme-generate-a-long-random-string

# Email transaccional — Resend (https://resend.com)
# RESEND_API_KEY: Clave API de Resend (obtén en https://resend.com/api-keys)
# DOCUSIA_CONTACT_EMAIL: Email de "From" (debe estar verificado en Resend)
# DOCUSIA_ADMIN_EMAILS: Emails receptores del formulario (separados por coma)
RESEND_API_KEY=re_your_api_key_here
DOCUSIA_CONTACT_EMAIL=info@docusia.es
DOCUSIA_ADMIN_EMAILS=team@example.com,info@example.com
